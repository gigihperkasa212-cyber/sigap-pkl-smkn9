        <div class="footer-sign" style="margin-top:30px;">
          <div class="sign-box">
            <p style="margin-bottom:4px;">Mengetahui,</p>
            <p style="margin-bottom:60px;">Kepala ${settings.schoolName || 'SMKN 9 Malang'},</p>
            <p><strong><u>${settings.principalName || 'Gigih Perkasa, ST., M.Pd.'}</u></strong></p>
            <p>NIP. ${settings.principalNip || '19841031 201101 1 008'}</p>
          </div>
          <div class="sign-box">
            <p style="margin-bottom:4px;">${settings.cityName || 'Malang'}, ${todayStr}</p>
            <p style="margin-bottom:60px;">${rightSignTitle}</p>
            <p>${rightSignName}</p>
            <p>${rightSignNip}</p>
          </div>
        </div>
      </div>

      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        window.onload = function() {
          try {
            const ctxDoughnut = document.getElementById('pdfDoughnutChartAdmin').getContext('2d');
            new Chart(ctxDoughnut, {
              type: 'doughnut',
              data: {
                labels: ['Hadir', 'Izin', 'Sakit', 'Alpa'],
                datasets: [{
                  data: [10, 2, 1, 0],
                  backgroundColor: ['#10b981', '#0284c7', '#f59e0b', '#ef4444'],
                  borderWidth: 2
                }]
              },
              options: {
                responsive: true,
                animation: false,
                plugins: {
                  legend: { position: 'bottom' }
                }
              }
            });
          } catch(e) {}

          setTimeout(function() {
            window.print();
          }, 650);
        };
      </script>
    </body>
    </html>
  `;
  _printAsPDF(_pdfRekapHtml, `SIGAP_Rekap_${new Date().toISOString().split('T')[0]}.pdf`);
}

// Bersihkan HTML agar kompatibel dengan mPDF � pertahankan layout tabel
function _cleanHtmlForPDF(html) {
  // Ambil hanya isi body
  var bodyMatch = html.match(/<body[^>]*>([\s\S]*)<\/body>/i);
  var body = bodyMatch ? bodyMatch[1] : html;

  // CSS minimal yang diperlukan mPDF untuk layout yang benar
  var css = '<style>' +
    'body{font-family:Arial,sans-serif;font-size:10pt;color:#000;background:#fff;margin:0;padding:0}' +
    'h1,h2{font-size:13pt;font-weight:bold;text-align:center;margin:6px 0}' +
    'h3,h4{font-size:11pt;font-weight:bold;margin:4px 0}' +
    'p,td,th,li{font-size:9.5pt;color:#000;margin:2px 0}' +
    'table{width:100%;border-collapse:collapse;margin:6px 0;page-break-inside:auto}' +
    'tr{page-break-inside:avoid}' +
    'td,th{border:1px solid #555;padding:3px 5px;font-size:9pt;vertical-align:top}' +
    'th{background-color:#4f46e5;color:#fff;font-weight:bold;text-align:center}' +
    'img{max-width:70px;max-height:70px}' +
    '.header-section{text-align:center;margin-bottom:10px}' +
    'hr{border:1px solid #000;margin:8px 0}' +
    '.signature-area{margin-top:20px;display:table;width:100%}' +
    '.sig-left{display:table-cell;width:50%;vertical-align:top}' +
    '.sig-right{display:table-cell;width:50%;vertical-align:top;text-align:right}' +
    '</style>';

  var clean = body
    // Hapus semua script
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '')
    // Hapus link CDN external
    .replace(/<link[^>]*(googleapis|cdnjs|unpkg|cloudflare|jsdelivr)[^>]*>/gi, '')
    // Hapus tombol print
    .replace(/<div[^>]*id="_autoPrintBar"[^>]*>[\s\S]*?<\/div>/gi, '')
    .replace(/<div[^>]*id="_ptb"[^>]*>[\s\S]*?<\/div>/gi, '')
    // Hapus gambar base64 besar (>500 chars) � ganti dengan placeholder
    .replace(/<img([^>]*?)src="data:[^"]{500,}"([^>]*)>/gi, '<img$1src=""$2>')
    // Bersihkan inline style yang menyebabkan background gelap
    .replace(/background(-color)?\s*:\s*(#[0-9a-fA-F]{3,6}|rgba?\([^)]+\)|linear-gradient[^;]+|radial-gradient[^;]+)\s*;?/gi, function(m, p1, color) {
      // Pertahankan warna terang, ganti warna gelap
      var hex = color.replace('#','');
      if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
      var r = parseInt(hex.substr(0,2),16)||0;
      if (r < 100) return 'background:#fff;';
      return m;
    })
    // Hapus class yang berisi komponen UI
    .replace(/\s*class="[^"]*(?:card|btn|badge|nav|modal|toast|overlay|tab-page|spinner)[^"]*"/gi, '');

  return '<!DOCTYPE html><html><head><meta charset="utf-8">' + css + '</head><body>' + clean + '</body></html>';
}

// Helper: tampilkan PDF dalam modal fullscreen dengan tombol Kembali + Simpan PDF
function _printAsPDF(htmlContent, fileName) {
  const title   = (fileName || 'SIGAP_Rekap').replace('.pdf', '');
  const pdfName = title + '.pdf';

  // Inject print style dalam HTML
  const ready = htmlContent
    .replace(/<title>[^<]*<\/title>/i, '<title>' + title + '</title>')
    .replace('</head>', '<style>@media print{@page{size:A4;margin:1cm}' +
      'body{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}' +
      '#_autoPrintBar{display:none!important}' +
      '.no-print{display:none!important}' +
      '.btn-print{display:none!important}' +
      '.btn-act{display:none!important}' +
      '}</style></head>')
    .replace(/window\.print\(\)\s*;/g, '/*noop*/')
    .replace(/<\/body>/i,
      '<div id="_autoPrintBar" style="position:fixed;bottom:0;left:0;right:0;' +
      'background:#1e293b;padding:12px;text-align:center;z-index:9999;">' +
      '<button onclick="window.print()" style="padding:10px 28px;background:#4f46e5;' +
      'color:#fff;border:none;border-radius:8px;font-size:1rem;font-weight:700;">' +
      '&#128424; Print / Save as PDF</button></div>' +
      '<script>window.addEventListener("load",function(){setTimeout(function(){window.print();},800);})<\/script>' +
      '</body>');

  // Modal preview fullscreen
  var modal = document.getElementById('_pdfModal');
  if (modal) modal.remove();
  modal = document.createElement('div');
  modal.id = '_pdfModal';
  modal.style.cssText = 'position:fixed;inset:0;z-index:999999;background:#0f172a;display:flex;flex-direction:column;';

  // Toolbar
  var bar     = document.createElement('div');
  var btnBack = document.createElement('button');
  var btnSave = document.createElement('button');
  var titleEl = document.createElement('span');

  bar.style.cssText = 'display:flex;align-items:center;gap:8px;padding:10px 16px;' +
    'background:#0f172a;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,0.12);';

  btnBack.innerHTML = '&#8592; Kembali';
  btnBack.style.cssText = 'padding:8px 12px;background:rgba(255,255,255,0.1);' +
    'color:#fff;border:1px solid rgba(255,255,255,0.2);border-radius:8px;cursor:pointer;' +
    'font-size:0.82rem;font-weight:600;flex-shrink:0;';

  titleEl.textContent = title;
  titleEl.style.cssText = 'flex:1;color:#e2e8f0;font-weight:700;font-size:0.78rem;' +
    'text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 4px;';

  btnSave.innerHTML = '&#128190; Simpan PDF';
  btnSave.style.cssText = 'padding:8px 12px;background:linear-gradient(135deg,#4f46e5,#3b82f6);' +
    'color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.82rem;font-weight:700;flex-shrink:0;';

  bar.appendChild(btnBack);
  bar.appendChild(titleEl);
  bar.appendChild(btnSave);

  // Iframe preview
  var frame = document.createElement('iframe');
  frame.style.cssText = 'flex:1;width:100%;border:none;background:#fff;';

  modal.appendChild(bar);
  modal.appendChild(frame);
  document.body.appendChild(modal);

  // Event listener via variable � tidak pakai getElementById
  btnBack.addEventListener('click', function() { modal.remove(); });
  btnSave.addEventListener('click', function() {
    _savePdfViaServer(ready, title, pdfName, btnSave);
  });

  // Load konten di iframe � sembunyikan tombol print di dalam dokumen
  var readyNoBtn = ready
    .replace(/<div[^>]*id="_autoPrintBar"[^>]*>[\s\S]*?<\/div>/gi, '')
    .replace(/<div[^>]*id="_ptb"[^>]*>[\s\S]*?<\/div>/gi, '')
    .replace(/<script[^>]*>window\.addEventListener[\s\S]*?<\/script>/gi, '')
    .replace('</head>', '<style>#_autoPrintBar,#_ptb,[id^="_auto"],[id^="_ptb"]{display:none!important}</style></head>');

  var blob    = new Blob([readyNoBtn], { type: 'text/html;charset=utf-8' });
  var blobUrl = URL.createObjectURL(blob);
  frame.src   = blobUrl;

  setTimeout(function() { URL.revokeObjectURL(blobUrl); }, 300000);
  showToast('Tap "Simpan PDF" untuk menyimpan ke HP', 'info');
}

// Generate PDF via server � kirim base64 langsung, simpan ke CACHE HP
function _savePdfViaServer(htmlContent, title, pdfName, btn) {
  if (btn) { btn.innerHTML = '&#9203; Generating...'; btn.disabled = true; }

  var FS    = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Filesystem;
  var Share = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Share;

  // Ganti CDN Chart.js dengan versi lokal di server agar bisa dirender Puppeteer
  var localChartUrl = window._SERVER_HTTPS + '/js/chart.umd.min.js';
  var htmlFixed = htmlContent
    .replace(/https:\/\/cdn\.jsdelivr\.net\/npm\/chart\.js[^"']*/gi, localChartUrl)
    .replace(/https:\/\/cdn\.jsdelivr\.net\/npm\/chart\.js/gi, localChartUrl)
    .replace(/<div[^>]*id="_autoPrintBar"[^>]*>[\s\S]*?<\/div>/gi, '')
    .replace(/<div[^>]*id="_ptb"[^>]*>[\s\S]*?<\/div>/gi, '');

  fetch(window._SERVER_HTTPS + '/api.php?action=generate_pdf_base64', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      html: htmlFixed,
      filename: title
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (!data || !data.base64) throw new Error('Server tidak mengembalikan data PDF');

    if (FS) {
      return FS.writeFile({
        path: pdfName,
        data: data.base64,
        directory: 'CACHE',
        recursive: true
      }).then(function(res) {
        if (btn) { btn.innerHTML = '&#128190; Simpan PDF'; btn.disabled = false; }
        showToast('PDF siap!', 'success');
        if (Share) {
          Share.share({
            title: pdfName,
            url: res.uri,
            dialogTitle: 'Simpan atau Buka PDF'
          }).catch(function(){});
        }
      });
    } else {
      // Browser fallback � decode base64 ke Blob
      var binary = atob(data.base64);
      var bytes  = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      var blob = new Blob([bytes], { type: 'application/pdf' });
      var url  = URL.createObjectURL(blob);
      var a    = document.createElement('a');
      a.href   = url;
      a.download = pdfName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function() { URL.revokeObjectURL(url); }, 10000);
      if (btn) { btn.innerHTML = '&#128190; Simpan PDF'; btn.disabled = false; }
      showToast('PDF berhasil dibuat!', 'success');
    }
  })
  .catch(function(e) {
    if (btn) { btn.innerHTML = '&#128190; Simpan PDF'; btn.disabled = false; }
    showToast('Gagal: ' + e.message, 'error');
  });
}
function previewImageModal(imageSrc, titleName) {
  const modal = document.getElementById('imagePreviewModal');
  const imgEl = document.getElementById('fullSizePreviewImg');
  const titleEl = document.getElementById('imagePreviewModalTitle');
  if (modal && imgEl) {
    imgEl.src = imageSrc;
    if (titleEl) titleEl.textContent = `Foto Presensi - ${titleName}`;
    modal.classList.remove('hidden');
  }
}

function closeImagePreviewModal() {
  const modal = document.getElementById('imagePreviewModal');
  if (modal) modal.classList.add('hidden');
}

function formatDateIndo(dateStr) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
}

function showToast(message, type = 'info') {
  const container = document.getElementById('toastContainer');
  if (!container) return;

  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  
  const iconMap = {
    success: 'fa-circle-check',
    error: 'fa-triangle-exclamation',
    info: 'fa-circle-info'
  };

  toast.innerHTML = `<i class="fa-solid ${iconMap[type]}"></i> <span>${message}</span>`;
  container.appendChild(toast);

  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(-10px) scale(0.95)';
    setTimeout(() => toast.remove(), 150);
  }, 1500);
}

function renderMonthlyReportsArchive() {
  const tbody = document.getElementById('monthlyReportsArchiveTable');
  if (!tbody) return;

  fetch('api.php?action=get_monthly_reports')
    .then(r => r.json())
    .then(data => {
      let reports = (data && data.success && Array.isArray(data.data) && data.data.length > 0) 
        ? data.data 
        : JSON.parse(localStorage.getItem('absensi_monthly_reports') || '[]');

      if (!reports || reports.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted" style="padding:16px;">Belum ada arsip laporan bulanan tersimpan. Silakan pilih bulan dan klik Cetak Rekap PDF Pembimbing untuk menyimpan ke database.</td></tr>`;
        return;
      }

      tbody.innerHTML = reports.map((r, i) => `
        <tr>
          <td style="text-align:center;">${i + 1}</td>
          <td><strong>${r.title || 'Rekap Presensi Bulanan'}</strong><br><small style="color:#a5b4fc;">Total: ${r.total_students || 0} Siswa</small></td>
          <td><span class="badge" style="background:#0284c7; color:#fff;">${r.month_name || 'Agustus'} ${r.year_num || 2026}</span></td>
          <td>${r.supervisor_filter || 'All Siswa'}</td>
          <td>${r.generated_by || 'Admin'}</td>
          <td><small style="color:#94a3b8;">${r.created_at || '-'}</small></td>
          <td style="text-align:center;">
            <button class="btn-sm btn-light" style="padding:4px 8px; font-size:0.75rem;" onclick="exportAdminRekapPDF()"><i class="fa-solid fa-file-pdf text-rose-400"></i> Cetak Ulang PDF</button>
          </td>
        </tr>
      `).join('');
    })
    .catch(() => {
      const reports = JSON.parse(localStorage.getItem('absensi_monthly_reports') || '[]');
      if (!reports || reports.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted" style="padding:16px;">Belum ada arsip laporan bulanan tersimpan.</td></tr>`;
        return;
      }
      tbody.innerHTML = reports.map((r, i) => `
        <tr>
          <td style="text-align:center;">${i + 1}</td>
          <td><strong>${r.title || 'Rekap Presensi Bulanan'}</strong><br><small style="color:#a5b4fc;">Total: ${r.total_students || 0} Siswa</small></td>
          <td><span class="badge" style="background:#0284c7; color:#fff;">${r.month_name || 'Agustus'} ${r.year_num || 2026}</span></td>
          <td>${r.supervisor_filter || 'All Siswa'}</td>
          <td>${r.generated_by || 'Admin'}</td>
          <td><small style="color:#94a3b8;">${r.created_at || '-'}</small></td>
          <td style="text-align:center;">
            <button class="btn-sm btn-light" style="padding:4px 8px; font-size:0.75rem;" onclick="exportAdminRekapPDF()"><i class="fa-solid fa-file-pdf text-rose-400"></i> Cetak Ulang PDF</button>
          </td>
        </tr>
      `).join('');
    });
}







