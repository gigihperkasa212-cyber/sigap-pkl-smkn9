// ══════════════════════════════════════════════════════════════════════
// CETAK LENGKAP — Laporan harian per siswa: foto selfie + peta lokasi
// Fungsi baru, tidak mengubah fungsi apapun yang sudah ada
// TTD: kiri = Kepala Sekolah, kanan = Guru Pembimbing PKL
// ══════════════════════════════════════════════════════════════════════
function exportCetakLengkap() {
  showToast('Menyiapkan laporan lengkap...', 'info');

  const users    = getUsers();
  const logs     = getLogs();
  const perms    = getPermissions();
  const settings = getSchoolSettings();
  const now      = new Date();
  const todayStr = now.toISOString().split('T')[0];

  // Ambil siswa sesuai peran
  const isAdminUser = activeUser && (activeUser.role === 'admin' || activeUser.username === 'admin');
  let targetSiswa = users.filter(function(u) { return u.role === 'siswa'; });
  if (!isAdminUser && activeUser && activeUser.role === 'guru') {
    var myStudents = getSupervisedStudentsOnly();
    var myIds = new Set(myStudents.map(function(s) { return String(s.id); }));
    targetSiswa = targetSiswa.filter(function(u) { return myIds.has(String(u.id)); });
  }

  if (targetSiswa.length === 0) {
    showToast('Tidak ada data siswa untuk dicetak.', 'error');
    return;
  }

  const teacherName   = activeUser ? activeUser.name : 'Guru Pembimbing';
  const teacherNip    = activeUser ? (activeUser.nomor_induk || '-') : '-';
  const schoolName    = settings.schoolName    || 'SMK Negeri 9 Malang';
  const cityName      = settings.cityName      || 'Malang';
  const principalName = settings.principalName || '_________________________';
  const principalNip  = settings.principalNip  || '-';
  const printDate     = now.toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' });

  // Hari ini atau filter bulan
  const monthNames = ['','Januari','Februari','Maret','April','Mei','Juni',
    'Juli','Agustus','September','Oktober','November','Desember'];
  const curMonth = now.getMonth() + 1;
  const curYear  = now.getFullYear();

  // Helper: minimap iframe OSM
  function makeMapIframe(lat, lng, label, w, h) {
    if (!lat || !lng || lat === 0 || lng === 0) {
      return '<div style="width:' + w + 'px;height:' + h + 'px;background:#f1f5f9;display:flex;' +
        'align-items:center;justify-content:center;border-radius:8px;color:#94a3b8;font-size:11px;' +
        'border:1px solid #e2e8f0;">📍 Koordinat belum tersedia</div>';
    }

    // Gunakan Google Maps Static Embed (bisa dibuka tanpa API key)
    // + fallback link Google Maps yang selalu bisa diklik
    var gmapUrl = 'https://www.google.com/maps?q=' + lat + ',' + lng +
      '&z=16&output=embed';
    var gmapLink = 'https://www.google.com/maps?q=' + lat + ',' + lng +
      '&z=16&label=' + encodeURIComponent(label || '');
    var osmLink = 'https://www.openstreetmap.org/?mlat=' + lat + '&mlon=' + lng + '&zoom=16';

    // Static tile image dari OSM — zoom 16, tile sekitar koordinat
    var zoom = 16;
    var tileX = Math.floor((lng + 180) / 360 * Math.pow(2, zoom));
    var tileY = Math.floor((1 - Math.log(Math.tan(lat * Math.PI / 180) +
      1 / Math.cos(lat * Math.PI / 180)) / Math.PI) / 2 * Math.pow(2, zoom));

    // 3x3 grid tile untuk tampil lebih luas
    var tilesHtml = '';
    for (var dy = -1; dy <= 1; dy++) {
      for (var dx = -1; dx <= 1; dx++) {
        var tx = tileX + dx, ty = tileY + dy;
        tilesHtml += '<img src="https://tile.openstreetmap.org/' + zoom + '/' + tx + '/' + ty + '.png" ' +
          'style="position:absolute;width:256px;height:256px;' +
          'top:' + ((dy+1)*256) + 'px;left:' + ((dx+1)*256) + 'px;" ' +
          'crossorigin="anonymous" onerror="this.style.opacity=0.3">';
      }
    }

    // Marker merah di tengah
    var markerHtml = '<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-100%);' +
      'z-index:10;font-size:28px;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));">📍</div>';

    // Label nama lokasi
    var labelHtml = '<div style="position:absolute;bottom:0;left:0;right:0;background:rgba(15,23,42,0.75);' +
      'color:#fff;font-size:10px;font-weight:700;padding:4px 8px;text-align:center;z-index:11;">' +
      (label||'Lokasi PKL').substring(0,60) + '</div>';

    return '<div style="position:relative;width:' + w + 'px;height:' + h + 'px;' +
      'overflow:hidden;border-radius:8px;border:1px solid #cbd5e1;background:#e8f4f8;">' +
      '<div style="position:absolute;top:' + (-(h/2-128)) + 'px;left:' + (-(w/2-128)) + 'px;' +
      'width:768px;height:768px;">' + tilesHtml + '</div>' +
      markerHtml + labelHtml +
      '</div>' +
      '<div style="margin-top:6px;display:flex;gap:8px;flex-wrap:wrap;">' +
        '<a href="' + gmapLink + '" target="_blank" rel="noopener" ' +
          'style="display:inline-flex;align-items:center;gap:5px;background:#4285f4;color:#fff;' +
          'padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;text-decoration:none;">' +
          '🗺️ Buka Google Maps</a>' +
        '<a href="' + osmLink + '" target="_blank" rel="noopener" ' +
          'style="display:inline-flex;align-items:center;gap:5px;background:#0891b2;color:#fff;' +
          'padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;text-decoration:none;">' +
          '🌍 OpenStreetMap</a>' +
        '<span style="font-size:10px;color:#94a3b8;align-self:center;">GPS: ' +
          lat.toFixed(5) + ', ' + lng.toFixed(5) + '</span>' +
      '</div>';
  }

  // Helper: format status badge
  function statusBadge(status) {
    var s = (status || '').toLowerCase();
    var bg = '#dcfce7', col = '#16a34a';
    if (s === 'alpa')   { bg = '#fee2e2'; col = '#dc2626'; }
    else if (s === 'izin')  { bg = '#fef9c3'; col = '#ca8a04'; }
    else if (s === 'sakit') { bg = '#dbeafe'; col = '#2563eb'; }
    else if (s.includes('luar radius')) { bg = '#fde68a'; col = '#92400e'; }
    return '<span style="background:' + bg + ';color:' + col + ';padding:2px 8px;' +
      'border-radius:8px;font-weight:700;font-size:11px;">' + (status||'-') + '</span>';
  }

  // ── Bangun tabel harian per siswa ──────────────────────────────────
  function buildSiswaSection(siswa, idx) {
    var lat = parseFloat(siswa.latitude_pkl)  || 0;
    var lng = parseFloat(siswa.longitude_pkl) || 0;

    // Ambil semua log siswa dari pkl_start_date, urutkan ascending
    var _siswaStart = siswa.pkl_start_date || siswa.created_date || null;
    var siswaLogs = logs
      .filter(function(l) {
        return l.studentName === siswa.name &&
          (!_siswaStart || (l.date||'') >= _siswaStart);
      })
      .sort(function(a, b) { return (a.date||'').localeCompare(b.date||''); });

    // Statistik ringkas
    var jHadir = siswaLogs.filter(function(l) { return (l.status||'').toLowerCase() === 'hadir' || (l.status||'').toLowerCase().includes('hadir'); }).length;
    var jIzin  = siswaLogs.filter(function(l) { return (l.status||'').toLowerCase() === 'izin';  }).length;
    var jSakit = siswaLogs.filter(function(l) { return (l.status||'').toLowerCase() === 'sakit'; }).length;
    var jAlpa  = siswaLogs.filter(function(l) { return (l.status||'').toLowerCase() === 'alpa';  }).length;

    // Foto paling terakhir untuk header kartu siswa
    var headerPhoto = '';
    var logsWithPhoto = siswaLogs.filter(function(l) { return l.image && l.image.startsWith('data:'); }).reverse();
    if (logsWithPhoto.length > 0) {
      headerPhoto = '<img src="' + logsWithPhoto[0].image + '" alt="Foto Terbaru" ' +
        'style="width:80px;height:80px;object-fit:cover;border-radius:50%;border:3px solid #0891b2;' +
        'display:block;margin:0 auto 6px;" onerror="this.style.display=\'none\'">';
    } else {
      headerPhoto = '<div style="width:80px;height:80px;border-radius:50%;background:#e2e8f0;' +
        'display:flex;align-items:center;justify-content:center;margin:0 auto 6px;font-size:28px;">🎓</div>';
    }

    // Baris per hari (dengan jurnal)
    var siswaJournals = (typeof getJournalsByStudent === 'function') ? getJournalsByStudent(siswa.name) : [];
    var rowsHtml = '';
    if (siswaLogs.length === 0) {
      rowsHtml = '<tr><td colspan="7" style="text-align:center;padding:16px;color:#94a3b8;font-style:italic;">' +
        'Belum ada data presensi.</td></tr>';
    } else {
      siswaLogs.forEach(function(l, ri) {
        // Ambil jurnal pada tanggal yang sama
        var jrn = siswaJournals.find(function(j) { return j.date === l.date; }) || null;
        var jrnCell = '';
        if (jrn) {
          var jFoto = jrn.image
            ? '<br><img src="' + jrn.image + '" style="width:60px;height:60px;object-fit:cover;border-radius:6px;margin-top:4px;border:1px solid #a5f3fc;" onerror="this.style.display=\'none\'">'
            : '';
          jrnCell = '<div style="font-size:10px;color:#0891b2;">' +
            (jrn.narasi||'').replace(/</g,'&lt;').substring(0,60) + (jrn.narasi&&jrn.narasi.length>60?'...':'') +
            jFoto + '</div>';
        } else {
          jrnCell = '<span style="color:#94a3b8;font-size:11px;font-style:italic;">—</span>';
        }
        var fotoCell = '';
        if (l.image && l.image.length > 20) {
          fotoCell = '<img src="' + l.image + '" alt="Selfie" ' +
            'style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid #cbd5e1;" ' +
            'onerror="this.style.display=\'none\'">';
        } else {
          fotoCell = '<span style="color:#cbd5e1;font-size:20px;">—</span>';
        }
        var rowBg = ri % 2 === 0 ? '#fff' : '#f8fafc';
        // Format tanggal jadi lebih ringkas: DD/MM/YYYY
        var rawDate = l.date || '-';
        var fmtDate = rawDate;
        if (rawDate.includes('T') || rawDate.includes(' ')) {
          rawDate = rawDate.split('T')[0].split(' ')[0];
        }
        if (rawDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
          var dp = rawDate.split('-');
          fmtDate = dp[2] + '/' + dp[1] + '/' + dp[0];
        }
        rowsHtml += '<tr style="background:' + rowBg + ';page-break-inside:avoid;">' +
          '<td style="padding:6px 8px;border:1px solid #e2e8f0;white-space:nowrap;font-size:11px;width:72px;">' + fmtDate + '</td>' +
          '<td style="padding:6px 8px;border:1px solid #e2e8f0;text-align:center;white-space:nowrap;font-size:11px;width:52px;">' + (l.masuk||'-') + '</td>' +
          '<td style="padding:6px 8px;border:1px solid #e2e8f0;text-align:center;white-space:nowrap;font-size:11px;width:52px;">' + (l.pulang||'-') + '</td>' +
          '<td style="padding:6px 8px;border:1px solid #e2e8f0;text-align:center;width:90px;">' + statusBadge(l.status) + '</td>' +
          '<td style="padding:6px 8px;border:1px solid #e2e8f0;font-size:10px;color:#334155;' +
            'word-wrap:break-word;word-break:break-word;white-space:normal;' +
            'text-align:justify;line-height:1.4;max-width:180px;width:180px;">' +
            (l.location||'-') + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #e2e8f0;text-align:center;width:54px;">' + fotoCell + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #e2e8f0;font-size:10px;' +
            'word-wrap:break-word;word-break:break-word;white-space:normal;' +
            'text-align:justify;line-height:1.4;width:130px;max-width:130px;">' + jrnCell + '</td>' +
          '</tr>';
      });
    }

    return '<div style="page-break-inside:avoid;border:1px solid #cbd5e1;border-radius:12px;' +
      'padding:20px;margin-bottom:32px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);">' +

      // Header Siswa
      '<div style="display:flex;align-items:flex-start;gap:16px;margin-bottom:16px;' +
        'border-bottom:2px solid #e2e8f0;padding-bottom:14px;">' +
        // Foto
        '<div style="text-align:center;min-width:90px;">' + headerPhoto +
          '<div style="font-size:10px;font-weight:700;color:#0891b2;">SISWA #' + (idx+1) + '</div>' +
        '</div>' +
        // Info
        '<div style="flex:1;">' +
          '<h3 style="margin:0 0 6px;font-size:15px;color:#0f172a;">' + siswa.name + '</h3>' +
          '<div style="font-size:12px;color:#475569;display:grid;grid-template-columns:repeat(2,1fr);gap:4px;">' +
            '<div>📋 NISN/NIS: <strong>' + (siswa.nomor_induk||'-') + '</strong></div>' +
            '<div>🏫 Kelas: <strong>' + (siswa.kelas||'-') + '</strong></div>' +
            '<div>📍 Lokasi PKL: <strong>' + (siswa.pklLocation||'-') + '</strong></div>' +
            '<div>👨‍🏫 Pembimbing: <strong>' + (siswa.supervisor||'-') + '</strong></div>' +
          '</div>' +
        '</div>' +
        // Statistik
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;min-width:120px;background:#f8fafc;' +
          'border-radius:10px;padding:12px;border:1px solid #e2e8f0;text-align:center;">' +
          '<div style="background:#dcfce7;border-radius:6px;padding:5px;">' +
            '<div style="font-size:18px;font-weight:900;color:#16a34a;">' + jHadir + '</div>' +
            '<div style="font-size:9px;color:#15803d;text-transform:uppercase;">Hadir</div></div>' +
          '<div style="background:#fef9c3;border-radius:6px;padding:5px;">' +
            '<div style="font-size:18px;font-weight:900;color:#ca8a04;">' + jIzin + '</div>' +
            '<div style="font-size:9px;color:#a16207;text-transform:uppercase;">Izin</div></div>' +
          '<div style="background:#dbeafe;border-radius:6px;padding:5px;">' +
            '<div style="font-size:18px;font-weight:900;color:#2563eb;">' + jSakit + '</div>' +
            '<div style="font-size:9px;color:#1d4ed8;text-transform:uppercase;">Sakit</div></div>' +
          '<div style="background:#fee2e2;border-radius:6px;padding:5px;">' +
            '<div style="font-size:18px;font-weight:900;color:#dc2626;">' + jAlpa + '</div>' +
            '<div style="font-size:9px;color:#b91c1c;text-transform:uppercase;">Alpa</div></div>' +
        '</div>' +
      '</div>' +

      // Peta Lokasi PKL
      '<div style="margin-bottom:16px;">' +
        '<p style="margin:0 0 8px;font-size:12px;font-weight:700;color:#475569;">🗺️ Peta Lokasi PKL: ' +
          (siswa.pklLocation||'-') +
          (lat !== 0 ? ' &nbsp;<a href="https://www.google.com/maps?q=' + lat + ',' + lng +
            '" target="_blank" style="font-size:10px;color:#0891b2;">(Buka Google Maps)</a>' : '') + '</p>' +
        makeMapIframe(lat, lng, siswa.pklLocation, 400, 200) +
      '</div>' +

      // Tabel Log Harian
      '<p style="margin:0 0 8px;font-size:12px;font-weight:700;color:#475569;">📅 Rekap Presensi Harian (' +
        siswaLogs.length + ' hari)</p>' +
      '<div style="overflow-x:auto;">' +
      '<table style="width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed;">' +
        '<colgroup>' +
          '<col style="width:72px;">' +
          '<col style="width:52px;">' +
          '<col style="width:52px;">' +
          '<col style="width:90px;">' +
          '<col style="width:auto;">' +
          '<col style="width:54px;">' +
          '<col style="width:130px;">' +
        '</colgroup>' +
        '<thead>' +
          '<tr style="background:#0f172a;color:#fff;">' +
            '<th style="padding:8px;text-align:left;border:1px solid #1e293b;font-size:11px;">Tanggal</th>' +
            '<th style="padding:8px;text-align:center;border:1px solid #1e293b;font-size:11px;">Masuk</th>' +
            '<th style="padding:8px;text-align:center;border:1px solid #1e293b;font-size:11px;">Pulang</th>' +
            '<th style="padding:8px;text-align:center;border:1px solid #1e293b;font-size:11px;">Status</th>' +
            '<th style="padding:8px;text-align:left;border:1px solid #1e293b;font-size:11px;">Keterangan Lokasi</th>' +
            '<th style="padding:8px;text-align:center;border:1px solid #1e293b;font-size:11px;">Foto</th>' +
            '<th style="padding:8px;text-align:left;border:1px solid #1e293b;font-size:11px;">Jurnal Harian</th>' +
          '</tr>' +
        '</thead>' +
        '<tbody>' + rowsHtml + '</tbody>' +
      '</table></div>' +

    '</div>';
  }

  // ── Hitung ringkasan total ─────────────────────────────────────────
  var grandHadir = 0, grandIzin = 0, grandSakit = 0, grandAlpa = 0;
  targetSiswa.forEach(function(s) {
    var sl = logs.filter(function(l) { return l.studentName === s.name; });
    sl.forEach(function(l) {
      var st = (l.status||'').toLowerCase();
      if (st === 'hadir' || st.includes('hadir')) grandHadir++;
      else if (st === 'izin')  grandIzin++;
      else if (st === 'sakit') grandSakit++;
      else if (st === 'alpa')  grandAlpa++;
    });
  });

  // ── Kartu per siswa ───────────────────────────────────────────────
  var allCards = targetSiswa.map(function(s, i) { return buildSiswaSection(s, i); }).join('');

  // ── Log monitoring guru ────────────────────────────────────────────
  var guruMonLogs = logs.filter(function(l) {
    return l.isGuruMonitoring === true &&
      activeUser && (l.studentName === activeUser.name);
  }).sort(function(a, b) { return (a.date||'').localeCompare(b.date||''); });

  var monitoringSection = '';
  if (guruMonLogs.length > 0) {
    var monRowsHtml = guruMonLogs.map(function(l, ri) {
      var rowBg = ri % 2 === 0 ? '#fff' : '#f0fdf4';
      var fotoCell = (l.image && l.image.length > 20)
        ? '<img src="' + l.image + '" style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid #cbd5e1;" onerror="this.style.display=\'none\'">'
        : '<span style="color:#cbd5e1;">—</span>';
      return '<tr style="background:' + rowBg + ';">' +
        '<td style="padding:8px 10px;border:1px solid #e2e8f0;">' + (l.date||'-') + '</td>' +
        '<td style="padding:8px 10px;border:1px solid #e2e8f0;text-align:center;">' + (l.masuk||'-') + '</td>' +
        '<td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:11px;color:#475569;max-width:200px;">' + (l.monitoringTarget||'-').substring(0,80) + '</td>' +
        '<td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:11px;color:#475569;max-width:160px;">' + (l.location||'-').substring(0,70) + '</td>' +
        '<td style="padding:6px 8px;border:1px solid #e2e8f0;text-align:center;">' + fotoCell + '</td>' +
        '</tr>';
    }).join('');

    monitoringSection =
      '<div style="page-break-inside:avoid;border:1px solid #a7f3d0;border-radius:12px;padding:20px;margin-bottom:32px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,0.05);">' +
      '<h3 style="font-size:14px;color:#065f46;margin:0 0 14px;border-bottom:2px solid #a7f3d0;padding-bottom:8px;">' +
      '🔍 Log Kunjungan Monitoring: ' + teacherName + ' (' + guruMonLogs.length + ' kunjungan)</h3>' +
      '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:12px;">' +
      '<thead><tr style="background:#065f46;color:#fff;">' +
      '<th style="padding:9px 10px;text-align:left;border:1px solid #047857;">Tanggal</th>' +
      '<th style="padding:9px 10px;text-align:center;border:1px solid #047857;">Jam</th>' +
      '<th style="padding:9px 10px;text-align:left;border:1px solid #047857;">Lokasi PKL Dimonitoring</th>' +
      '<th style="padding:9px 10px;text-align:left;border:1px solid #047857;">Keterangan GPS</th>' +
      '<th style="padding:9px 10px;text-align:center;border:1px solid #047857;">Foto</th>' +
      '</tr></thead><tbody>' + monRowsHtml + '</tbody></table></div></div>';
  }

  // ── HTML Dokumen Lengkap ───────────────────────────────────────────
  var html = '<!DOCTYPE html><html lang="id"><head>' +
    '<meta charset="UTF-8">' +
    '<title>Laporan Lengkap Presensi PKL - ' + schoolName + '</title>' +
    '<style>' +
    '* { box-sizing:border-box; margin:0; padding:0; }' +
    'body { font-family:\'Segoe UI\',Arial,sans-serif; background:#f8fafc; color:#1e293b; font-size:11px; }' +
    '.page { max-width:960px; margin:0 auto; padding:24px 20px 60px; background:#fff; }' +
    'table { width:100%; border-collapse:collapse; table-layout:fixed; word-wrap:break-word; }' +
    'td, th { word-wrap:break-word; word-break:break-word; overflow-wrap:break-word; overflow:hidden; ' +
    '  vertical-align:top; }' +
    'p { text-align:justify; line-height:1.5; }' +
    '@media print {' +
    '  body { background:#fff; }' +
    '  .page { padding:16px; max-width:100%; }' +
    '  .no-print { display:none !important; }' +
    '  tr { page-break-inside:avoid; }' +
    '  .siswa-block { page-break-before:always; }' +
    '  .siswa-block:first-child { page-break-before:auto; }' +
    '  iframe { -webkit-print-color-adjust:exact; print-color-adjust:exact; }' +
    '}' +
    '.kop-container { display:flex; align-items:center; border-bottom:3px solid #000; padding-bottom:8px; margin-bottom:15px; }' +
    '.logo-box { width:90px; text-align:left; flex-shrink:0; }' +
    '.logo-box img { width:75px; height:auto; }' +
    '.header-text { flex:1; text-align:center; margin-right:40px; }' +
    '.header-text h3 { margin:0; font-size:14px; font-weight:normal; text-transform:uppercase; letter-spacing:0.5px; }' +
    '.header-text h2 { margin:2px 0; font-size:18px; font-weight:bold; text-transform:uppercase; letter-spacing:0.5px; }' +
    '.header-text p  { margin:2px 0; font-size:10px; color:#111; }' +
    '.summary-bar { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-bottom:24px; }' +
    '.sum-card { border-radius:10px; padding:12px; text-align:center; border:1px solid #e2e8f0; }' +
    '.sum-card .num { font-size:26px; font-weight:900; }' +
    '.sum-card .lbl { font-size:10px; text-transform:uppercase; letter-spacing:1px; color:#64748b; margin-top:2px; }' +
    '.btn-act { display:inline-block; padding:10px 22px; border-radius:8px; border:none;' +
    '  font-size:13px; font-weight:700; cursor:pointer; margin-bottom:20px; margin-right:8px; }' +
    '.ttd-area { margin-top:40px; display:grid; grid-template-columns:1fr 1fr; gap:60px; page-break-inside:avoid; }' +
    '.ttd-col { text-align:center; font-size:12px; }' +
    '.ttd-col .space { height:65px; }' +
    '.ttd-col .name-line { border-top:1px solid #0f172a; padding-top:4px; display:inline-block; min-width:180px; font-weight:700; }' +
    '</style></head><body><div class="page">' +

    // Tombol aksi
    // Kop Surat — identik dengan Cetak Statistik dan Cetak Rekap
    '<div class="kop-container">' +
    '<div class="logo-box">' +
    '<img src="img/logo_jatim.png" ' +
    'onerror="this.onerror=null; this.src=\'https://upload.wikimedia.org/wikipedia/commons/thumb/7/74/Coat_of_arms_of_East_Java.svg/500px-Coat_of_arms_of_East_Java.svg.png\';" ' +
    'alt="Logo Resmi Pemerintah Provinsi Jawa Timur" ' +
    'style="width:85px; height:auto; display:block; margin:0 auto;">' +
    '</div>' +
    '<div class="header-text">' +
    '<h3>PEMERINTAH PROVINSI JAWA TIMUR</h3>' +
    '<h3>DINAS PENDIDIKAN</h3>' +
    '<h2>' + schoolName + '</h2>' +
    '<p>Jalan Sampurna Nomor 1, Cemorokandang, Kedungkandang, Malang, 65138</p>' +
    '<p>Telepon 0341727998, Laman <a href="https://smkn9malang.sch.id/" style="color:#0284c7; text-decoration:underline;">https://smkn9malang.sch.id/</a>, ' +
    'Pos-el <a href="mailto:surat@smkn9malang.sch.id" style="color:#0284c7; text-decoration:underline;">surat@smkn9malang.sch.id</a></p>' +
    '</div></div>' +

    // Judul
    '<div style="text-align:center;margin:16px 0 20px;">' +
    '<h2 style="font-size:16px;font-weight:900;text-transform:uppercase;letter-spacing:1px;">Laporan Presensi Harian PKL</h2>' +
    '<p style="font-size:12px;color:#475569;margin-top:4px;">' +
    'Guru Pembimbing: <strong>' + teacherName + '</strong> &nbsp;|&nbsp; NIP: <strong>' + teacherNip + '</strong>' +
    '</p>' +
    '<p style="font-size:12px;color:#475569;margin-top:2px;">' +
    'Jumlah Siswa: <strong>' + targetSiswa.length + ' siswa</strong>' +
    ' &nbsp;|&nbsp; Dicetak: <strong>' + printDate + '</strong></p>' +
    '</div>' +

    // Ringkasan
    '<div class="summary-bar">' +
    '<div class="sum-card" style="background:#f0fdf4;border-color:#bbf7d0;">' +
    '<div class="num" style="color:#16a34a;">' + targetSiswa.length + '</div><div class="lbl">Siswa</div></div>' +
    '<div class="sum-card" style="background:#dcfce7;border-color:#86efac;">' +
    '<div class="num" style="color:#16a34a;">' + grandHadir + '</div><div class="lbl">Hadir</div></div>' +
    '<div class="sum-card" style="background:#fef9c3;border-color:#fde047;">' +
    '<div class="num" style="color:#ca8a04;">' + grandIzin + '</div><div class="lbl">Izin</div></div>' +
    '<div class="sum-card" style="background:#dbeafe;border-color:#93c5fd;">' +
    '<div class="num" style="color:#2563eb;">' + grandSakit + '</div><div class="lbl">Sakit</div></div>' +
    '<div class="sum-card" style="background:#fee2e2;border-color:#fca5a5;">' +
    '<div class="num" style="color:#dc2626;">' + grandAlpa + '</div><div class="lbl">Alpa</div></div>' +
    '</div>' +

    // Kartu per siswa + log monitoring guru
    allCards + monitoringSection +
    '</div></body></html>';

    // Tanda Tangan: role-aware
    // Admin: kiri=Waka Humas, tengah=Kepala Sekolah, kanan=Ketua Pokja PKL
    // Guru: kiri=Kepala Sekolah, kanan=Guru Pembimbing PKL
    var wakaHumasName = settings.wakaHumasName || '_________________________';
    var wakaHumasNip  = settings.wakaHumasNip  || '-';
    var pokjaName     = settings.pokjaName     || '_________________________';
    var pokjaNip      = settings.pokjaNip      || '-';

    var ttdHtml = '';
    if (isAdminUser) {
      ttdHtml =
        '<div style="margin-top:40px;">' +
        '<!-- Baris atas: Waka Humas (kiri) | Ketua Pokja PKL (kanan) -->' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:60px;width:100%;">' +
          '<div class="ttd-col" style="text-align:center;padding-left:20px;">' +
            '<p>' + cityName + ', ' + printDate + '</p>' +
            '<p style="margin-top:4px;">Waka Humas,</p>' +
            '<div class="space"></div>' +
            '<div><span class="name-line">' + wakaHumasName + '</span><br><small>NIP. ' + wakaHumasNip + '</small></div>' +
          '</div>' +
          '<div class="ttd-col" style="text-align:center;padding-right:20px;">' +
            '<p>' + cityName + ', ' + printDate + '</p>' +
            '<p style="margin-top:4px;">Ketua Pokja PKL,</p>' +
            '<div class="space"></div>' +
            '<div><span class="name-line">' + pokjaName + '</span><br><small>NIP. ' + pokjaNip + '</small></div>' +
          '</div>' +
        '</div>' +
        '<!-- Baris bawah: Kepala Sekolah di tengah -->' +
        '<div style="display:flex;justify-content:center;margin-top:40px;">' +
          '<div class="ttd-col" style="text-align:center;min-width:220px;">' +
            '<p>Mengetahui,</p>' +
            '<p style="font-size:11px;color:#64748b;">Kepala ' + schoolName + ',</p>' +
            '<div class="space"></div>' +
            '<div><span class="name-line">' + principalName + '</span><br><small>NIP. ' + principalNip + '</small></div>' +
          '</div>' +
        '</div>' +
        '</div>';
    } else {
      ttdHtml = '<div class="ttd-area">' +
        '<div class="ttd-col"><p>' + cityName + ', ' + printDate + '</p>' +
        '<p style="margin-top:4px;">Mengetahui,</p><p style="font-size:11px;color:#64748b;">Kepala ' + schoolName + ',</p><div class="space"></div>' +
        '<div><span class="name-line">' + principalName + '</span><br><small>NIP. ' + principalNip + '</small></div></div>' +
        '<div class="ttd-col"><p>' + cityName + ', ' + printDate + '</p>' +
        '<p style="margin-top:4px;">Guru Pembimbing PKL,</p><div class="space"></div>' +
        '<div><span class="name-line">' + teacherName + '</span><br><small>NIP. ' + teacherNip + '</small></div></div>' +
        '</div>';
    }
    html = html.replace('</div></body></html>', ttdHtml + '</div></body></html>');

    html.replace('</div></body></html>', ttdHtml + '</div></body></html>');

  // Gunakan _printAsPDF() — modal in-page, identik dengan Cetak Statistik dan Cetak Rekap
  var pdfFileName = 'Laporan_Lengkap_PKL_' + (activeUser ? activeUser.name.replace(/[^a-zA-Z0-9]/g,'_') : 'Admin') + '_' + new Date().toISOString().split('T')[0] + '.pdf';
  _printAsPDF(html, pdfFileName);
  showToast('Laporan Lengkap berhasil dibuka!', 'success');
}

window.exportCetakLengkap = exportCetakLengkap;



// ══════════════════════════════════════════════════════════════════
// THEME TOGGLE — Mode Siang (light) / Mode Malam (dark)
// Default: light. Preferensi disimpan di localStorage.
// Tidak mengubah fungsi/syntax apapun yang sudah ada.
// ══════════════════════════════════════════════════════════════════

var SIGAP_THEME_KEY = 'SIGAP_PKL_K9_theme_v1';

function applyTheme(theme) {
  var body = document.body;
  if (!body) return;

  if (theme === 'dark') {
    body.removeAttribute('data-theme');
  } else {
    body.setAttribute('data-theme', 'light');
  }

  // Update label & aria
  var label = document.getElementById('themeToggleLabel');
  var btn   = document.getElementById('themeToggleBtn');
  if (label) label.textContent = (theme === 'dark') ? 'Malam' : 'Siang';
  if (btn)   btn.setAttribute('title', (theme === 'dark') ? 'Ganti ke Mode Siang' : 'Ganti ke Mode Malam');

  // Simpan preferensi
  try { localStorage.setItem(SIGAP_THEME_KEY, theme); } catch(e) {}

  console.log('[SIGAP] Theme:', theme);
}

function toggleTheme() {
  var current = document.body && document.body.getAttribute('data-theme');
  var next = (current === 'light') ? 'dark' : 'light';
  applyTheme(next);
}

function initTheme() {
  // Baca preferensi tersimpan, default = 'light'
  var saved = 'light';
  try { saved = localStorage.getItem(SIGAP_THEME_KEY) || 'light'; } catch(e) {}
  applyTheme(saved);
}

// Jalankan saat DOM siap
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initTheme);
} else {
  initTheme();
}

window.toggleTheme = toggleTheme;
window.applyTheme  = applyTheme;
window.initTheme   = initTheme;
// ══════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// LIGHT MODE CHART THEME — Update warna Chart.js saat mode berubah
// Semua kode baru, tidak ada yang diubah dari fungsi yang sudah ada
// ══════════════════════════════════════════════════════════════════

/**
 * Warna chart berdasarkan tema
 */
function _getChartThemeColors(theme) {
  if (theme === 'light') {
    return {
      legendColor:  '#0f172a',
      tickColor:    '#0f172a',
      gridColor:    'rgba(15, 23, 42, 0.25)',
      borderColor:  '#fff',
      textFontWeight: 'bold',
      centerTextColor: '#0f172a',
      centerSubColor:  '#334155'
    };
  }
  // dark (default)
  return {
    legendColor:  '#e2e8f0',
    tickColor:    '#e2e8f0',
    gridColor:    'rgba(255, 255, 255, 0.05)',
    borderColor:  '#1e293b',
    textFontWeight: 'bold',
    centerTextColor: '#ffffff',
    centerSubColor:  '#94a3b8'
  };
}

/**
 * Update semua Chart.js instances agar kontras sesuai tema aktif
 * Dipanggil otomatis setiap kali tema berubah
 */
function updateChartsForTheme(theme) {
  var colors = _getChartThemeColors(theme);
  var instances = [];

  // Kumpulkan semua instance yang aktif
  if (typeof chartInstanceH1  !== 'undefined' && chartInstanceH1)  instances.push(chartInstanceH1);
  if (typeof chartInstanceH   !== 'undefined' && chartInstanceH)   instances.push(chartInstanceH);
  if (typeof chartInstanceCompBar !== 'undefined' && chartInstanceCompBar) instances.push(chartInstanceCompBar);
  if (typeof attendanceChartInstance !== 'undefined' && attendanceChartInstance) instances.push(attendanceChartInstance);

  instances.forEach(function(chart) {
    if (!chart || !chart.options) return;

    // Update legend label color
    if (chart.options.plugins && chart.options.plugins.legend) {
      var legendLabels = chart.options.plugins.legend.labels;
      if (legendLabels) {
        legendLabels.color = colors.legendColor;
        legendLabels.font = legendLabels.font || {};
        legendLabels.font.weight = 'bold';
      }
    }

    // Update axis ticks & grid
    if (chart.options.scales) {
      ['x', 'y'].forEach(function(axis) {
        if (chart.options.scales[axis]) {
          var sc = chart.options.scales[axis];
          if (sc.ticks) {
            sc.ticks.color = colors.tickColor;
            sc.ticks.font = sc.ticks.font || {};
            sc.ticks.font.weight = 'bold';
          }
          if (sc.grid) {
            sc.grid.color = colors.gridColor;
          }
        }
      });
    }

    // Update dataset border color (doughnut)
    if (chart.data && chart.data.datasets) {
      chart.data.datasets.forEach(function(ds) {
        if (ds.borderColor && !Array.isArray(ds.borderColor)) {
          // Hanya update borderColor yang merupakan single color (bukan array gradient)
          if (ds.borderColor === '#1e293b' || ds.borderColor === '#fff') {
            ds.borderColor = (theme === 'light') ? 'rgba(255,255,255,0.8)' : '#1e293b';
          }
        }
      });
    }

    try { chart.update('none'); } catch(e) {}
  });

  // Update Chart.js global defaults agar chart yang di-render ulang nanti juga kontras
  if (typeof Chart !== 'undefined' && Chart.defaults) {
    Chart.defaults.color = colors.legendColor;
    if (Chart.defaults.scale) {
      Chart.defaults.scale.ticks = Chart.defaults.scale.ticks || {};
      Chart.defaults.scale.ticks.color = colors.tickColor;
      if (Chart.defaults.scale.grid) {
        Chart.defaults.scale.grid.color = colors.gridColor;
      }
    }
  }

  // Re-render chart agar perubahan terlihat (terutama bar chart)
  if (instances.length > 0) {
    try {
      if (typeof renderChart === 'function') {
        renderChart();
      }
    } catch(e) {}
  }
}

// ── Hook ke applyTheme menggunakan window property (tidak redeclare function)
// Cara aman: simpan ref asli via window, override via window assignment
// (function declaration bisa hoisting, tapi window assignment tidak)
(function() {
  // Tunggu sampai applyTheme asli sudah terdefinisi
  function _hookApplyTheme() {
    var _orig = window.applyTheme;
    if (typeof _orig !== 'function') return;

    window.applyTheme = function(theme) {
      // Panggil fungsi asli (baris 9784)
      _orig(theme);
      // Update chart colors setelah DOM update
      setTimeout(function() {
        updateChartsForTheme(theme);
      }, 80);
    };
    // Pastikan toggleTheme menggunakan wrapper baru
    window.toggleTheme = function() {
      var current = document.body && document.body.getAttribute('data-theme');
      var next = (current === 'light') ? 'dark' : 'light';
      window.applyTheme(next);
    };
  }

  // Hook segera (applyTheme sudah terdefinisi saat ini)
  _hookApplyTheme();

  // Sinkronisasi chart saat pertama load
  var savedTheme = 'light';
  try { savedTheme = localStorage.getItem('SIGAP_PKL_K9_theme_v1') || 'light'; } catch(e) {}
  setTimeout(function() {
    updateChartsForTheme(savedTheme);
  }, 900);
})();

window.updateChartsForTheme = updateChartsForTheme;
// ══════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// _ensureMonitoringBtn — Safety net: pastikan tombol di tab home
// selalu sesuai role. Dipanggil saat switchTab('home') dan setelah login.
// Tidak mengubah apapun yang sudah ada.
// ══════════════════════════════════════════════════════════════════
function _ensureMonitoringBtn() {
  if (!activeUser) return;

  var isGuruOrAdmin = activeUser.role === 'guru' ||
                      activeUser.role === 'admin' ||
                      activeUser.username === 'admin';

  // ── Fix label navPermBtn sesuai role ──
  var navPermBtn = document.getElementById('navPermBtn');
  if (navPermBtn) {
    if (isGuruOrAdmin) {
      navPermBtn.innerHTML = '<i class="fa-solid fa-list-check"></i><span>Log Presensi</span>';
    } else {
      navPermBtn.innerHTML = '<i class="fa-solid fa-file-signature"></i><span>Izin/Sakit</span>';
    }
  }

  // ── Set data-role di body — CSS yang mengatur visibility tombol ──
  var role = activeUser.username === 'admin' ? 'admin' : (activeUser.role || 'siswa');
  document.body.setAttribute('data-role', role);

  // Update label monitoring
  var monLabel = document.getElementById('monitoringBtnLabel');
  if (monLabel && isGuruOrAdmin) {
    monLabel.textContent = (role === 'admin') ? 'Verifikasi Kunjungan PKL' : 'Verifikasi Lokasi PKL Siswa';
  }
}

window._ensureMonitoringBtn = _ensureMonitoringBtn;

// Panggil juga saat DOM ready untuk catch kasus awal load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(_ensureMonitoringBtn, 500);
  });
} else {
  setTimeout(_ensureMonitoringBtn, 500);
}

// Interval check: jalankan setiap 1.5 detik, berhenti setelah tombol confirmed ada (max 15 detik)
var _monitoringBtnInterval = null;
function _startMonitoringBtnWatch() {
  if (_monitoringBtnInterval) clearInterval(_monitoringBtnInterval);
  var _watchCount = 0;
  _monitoringBtnInterval = setInterval(function() {
    _watchCount++;
    if (!activeUser) { clearInterval(_monitoringBtnInterval); return; }
    var isGA = activeUser.role === 'guru' || activeUser.role === 'admin' || activeUser.username === 'admin';
    if (!isGA) { clearInterval(_monitoringBtnInterval); return; }
    var container = document.getElementById('attendanceActionsContainer');
    var hasBtn = container && container.querySelector('#btnAbsenMonitoring');
    if (hasBtn) {
      clearInterval(_monitoringBtnInterval); // sudah ada — stop
      return;
    }
    _ensureMonitoringBtn(); // belum ada — inject ulang
    if (_watchCount >= 10) clearInterval(_monitoringBtnInterval); // max 15 detik
  }, 1500);
}
window._startMonitoringBtnWatch = _startMonitoringBtnWatch;
// ══════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// _updateAbsenBtnState — Disable/enable tombol absen siswa sesuai kondisi hari ini
// Aturan: satu absen masuk + satu absen pulang per hari
// Tidak mengubah fungsi apapun yang sudah ada
// ══════════════════════════════════════════════════════════════════
function _updateAbsenBtnState() {
  if (!activeUser || activeUser.role !== 'siswa') return;

  var logs    = getLogs();
  var perms   = getPermissions();
  var today   = new Date().toISOString().split('T')[0];

  // Cek absen masuk hari ini
  var sudahMasuk = logs.find(function(l) {
    return l.studentName === activeUser.name &&
      l.date === today &&
      l.masuk && l.masuk !== '-' &&
      !(l.status||'').toLowerCase().includes('izin') &&
      !(l.status||'').toLowerCase().includes('sakit');
  });

  // Cek absen pulang hari ini
  var sudahPulang = logs.find(function(l) {
    return l.studentName === activeUser.name &&
      l.date === today &&
      l.pulang && l.pulang !== '-';
  });

  // Cek izin/sakit hari ini (Pending atau Disetujui)
  var adaIzin = perms.find(function(p) {
    return p.studentName === activeUser.name &&
      p.startDate <= today && p.endDate >= today &&
      p.status !== 'Ditolak';
  });

  // Ambil container absen
  var container = document.getElementById('attendanceActionsContainer');
  if (!container) return;

  var btnMasuk  = document.getElementById('btnAbsenMasuk');
  var btnPulang = document.getElementById('btnAbsenPulang');
  if (!btnMasuk || !btnPulang) return;

  // Jika ada izin hari ini — disable kedua tombol
  if (adaIzin) {
    _disableAbsenBtn(btnMasuk,  'Izin/Sakit hari ini (' + (adaIzin.status) + ')');
    _disableAbsenBtn(btnPulang, 'Izin/Sakit hari ini (' + (adaIzin.status) + ')');
    return;
  }

  // Tombol Absen Masuk
  if (sudahMasuk) {
    _disableAbsenBtn(btnMasuk, 'Sudah masuk: ' + sudahMasuk.masuk);
  } else {
    _enableAbsenBtn(btnMasuk);
  }

  // Tombol Absen Pulang
  if (sudahPulang) {
    _disableAbsenBtn(btnPulang, 'Sudah pulang: ' + sudahPulang.pulang);
  } else if (!sudahMasuk) {
    _disableAbsenBtn(btnPulang, 'Belum absen masuk hari ini');
  } else {
    _enableAbsenBtn(btnPulang);
  }
}

function _disableAbsenBtn(btn, alasan) {
  if (!btn) return;
  btn.disabled = true;
  btn.style.opacity = '0.45';
  btn.style.cursor  = 'not-allowed';
  var span = btn.querySelector('.action-text span');
  if (span) span.textContent = alasan;
  btn.title = alasan;
}

function _enableAbsenBtn(btn) {
  if (!btn) return;
  btn.disabled = false;
  btn.style.opacity = '1';
  btn.style.cursor  = 'pointer';
  btn.title = '';
}

window._updateAbsenBtnState = _updateAbsenBtnState;
// ══════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// AUTO-ALPA — Tandai siswa yang tidak absen di hari kerja lalu sebagai Alpa
// Aturan: jika hari ini sudah lewat 1 hari (H-1 adalah hari kerja Senin-Sabtu),
//         siswa tidak punya log apapun (masuk/pulang/izin/sakit) → buat log Alpa
// Dipanggil saat: syncDataFromServer, login, dan polling 8 detik
// Tidak mengubah log yang sudah ada
// ══════════════════════════════════════════════════════════════════
function _runAutoAlpa() {
  if (!activeUser) return;

  var users = getUsers();
  var logs  = getLogs();
  var perms = getPermissions();
  var now   = new Date();

  // Tentukan list siswa yang perlu dicek
  var siswaCek = [];
  if (activeUser.role === 'siswa') {
    // Siswa hanya cek dirinya sendiri
    var me = users.find(function(u) { return String(u.id) === String(activeUser.id); });
    if (me) siswaCek.push(me);
  } else if (activeUser.role === 'guru' && activeUser.username !== 'admin') {
    siswaCek = (typeof getSupervisedStudentsOnly === 'function') ? getSupervisedStudentsOnly() : [];
  } else if (activeUser.role === 'admin' || activeUser.username === 'admin') {
    siswaCek = users.filter(function(u) { return u.role === 'siswa'; });
  }

  if (!siswaCek || siswaCek.length === 0) return;

  // Cek dari pkl_start_date siswa sampai kemarin (maks 365 hari ke belakang)
  var newAlpaLogs = [];
  var changed = false;

  // Rentang: dari pkl_start_date sampai kemarin
  var maxLookback = 365;
  for (var d = 1; d <= maxLookback; d++) {
    var checkDate = new Date(now);
    checkDate.setDate(now.getDate() - d);
    var dayOfWeek = checkDate.getDay(); // 0=Minggu, 6=Sabtu

    // Skip Minggu — bukan hari kerja PKL
    if (dayOfWeek === 0) continue;

    var dateStr = checkDate.toISOString().split('T')[0];

    siswaCek.forEach(function(siswa) {
      if (!siswa || !siswa.name) return;

      // Jangan buat alpa sebelum tanggal mulai PKL siswa
      var pklStart = siswa.pkl_start_date || siswa.created_date || null;
      if (pklStart && dateStr < pklStart) return; // sebelum mulai PKL, skip

      // Sudah ada log (apapun) di tanggal ini?
      var hasLog = logs.some(function(l) {
        return l.studentName === siswa.name && l.date === dateStr;
      });
      if (hasLog) return; // sudah ada data, skip

      // Sudah ada izin/sakit di tanggal ini?
      var hasIzin = perms.some(function(p) {
        return p.studentName === siswa.name &&
          (p.startDate||'') <= dateStr &&
          (p.endDate||'') >= dateStr &&
          p.status !== 'Ditolak';
      });
      if (hasIzin) return; // ada izin, bukan alpa

      // Tidak ada data apapun → tandai Alpa
      var alpaLog = {
        id: 'alpa_' + siswa.name.replace(/\s+/g,'_') + '_' + dateStr,
        _localTs: Date.now(),
        _autoAlpa: true,
        studentName: siswa.name,
        supervisor:  siswa.supervisor || '',
        date:        dateStr,
        masuk:       '-',
        pulang:      '-',
        status:      'Alpa',
        location:    'Tanpa Keterangan (Tidak Absen)',
        image:       null
      };

      // Pastikan belum ada log alpa untuk siswa+tanggal ini
      var dupAlpa = logs.some(function(l) {
        return l.studentName === siswa.name && l.date === dateStr && l.status === 'Alpa';
      });
      if (!dupAlpa) {
        logs.push(alpaLog);
        newAlpaLogs.push(alpaLog);
        changed = true;
        console.log('[SIGAP] Auto-alpa:', siswa.name, dateStr);
      }
    });
  }

  if (changed) {
    saveLogs(logs);

    // Kirim alpa baru ke server (batch, fire-and-forget)
    newAlpaLogs.forEach(function(al) {
      fetch(apiUrl('api.php?action=simpan_presensi'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(al)
      }).catch(function() {});
    });

    // Re-render statistik
    try { renderStats(); } catch(e) {}
    try { renderHistoryList(); } catch(e) {}
    try { renderTodayStatus(); } catch(e) {}
    if (document.getElementById('tab-admin')?.classList.contains('active')) {
      try { renderAdminDashboard(); } catch(e) {}
    }

    console.log('[SIGAP] Auto-alpa: ' + newAlpaLogs.length + ' log baru dibuat');
  }
}

window._runAutoAlpa = _runAutoAlpa;
// ══════════════════════════════════════════════════════════════════
