          <div style="display:flex; align-items:center; gap:12px;">
            <div id="editUserAvatar" style="width:56px; height:56px; border-radius:50%; background:linear-gradient(135deg, #4f46e5, #6366f1); display:flex; align-items:center; justify-content:center; font-size:1.8rem; color:#fff; font-weight:bold;">
              <!-- Initial will be inserted by JS -->
            </div>
            <div style="flex:1;">
              <h4 id="editUserName" style="margin:0; font-size:1.1rem; color:#fff;">-</h4>
              <p id="editUserRole" style="margin:4px 0 0 0; font-size:0.85rem; color:#94a3b8;">-</p>
            </div>
          </div>
        </div>

        <!-- Tabs Navigation -->
        <div style="display:flex; gap:8px; margin-bottom:20px; border-bottom:2px solid rgba(255,255,255,0.1); padding-bottom:4px;">
          <button type="button" class="edit-tab-btn active" onclick="switchEditTab('basic')" data-tab="basic">
            <i class="fa-solid fa-user"></i> Data Dasar
          </button>
          <button type="button" class="edit-tab-btn" onclick="switchEditTab('location')" data-tab="location" id="editTabLocation">
            <i class="fa-solid fa-location-dot"></i> Lokasi PKL
          </button>
          <button type="button" class="edit-tab-btn" onclick="switchEditTab('supervisor')" data-tab="supervisor" id="editTabSupervisor" style="display:none;">
            <i class="fa-solid fa-user-tie"></i> Pembimbing
          </button>
          <button type="button" class="edit-tab-btn" onclick="switchEditTab('security')" data-tab="security">
            <i class="fa-solid fa-shield-halved"></i> Keamanan
          </button>
        </div>

        <!-- Tab Content: Basic Data -->
        <div id="editTabBasic" class="edit-tab-content active">
          <div class="form-group">
            <label><i class="fa-solid fa-user-pen text-sky-400"></i> Username</label>
            <input type="text" id="editUsername" placeholder="Username" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
            <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:4px;">
              <i class="fa-solid fa-info-circle"></i> Username digunakan untuk login
            </small>
          </div>

          <div class="form-group" id="editKelasGroup" style="display:none;">
            <label><i class="fa-solid fa-chalkboard text-emerald-400"></i> Kelas</label>
            <input type="text" id="editKelas" placeholder="Contoh: XII RPL 1" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
            <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:4px;">
              <i class="fa-solid fa-info-circle"></i> Kelas siswa saat ini
            </small>
          </div>

          <div class="form-group">
            <label><i class="fa-solid fa-id-card text-amber-400"></i> NISN / NIP</label>
            <input type="text" id="editNomorInduk" readonly style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.5); border:1px solid rgba(255,255,255,0.2); border-radius:8px; color:#94a3b8; cursor:not-allowed;">
            <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:4px;">
              <i class="fa-solid fa-lock"></i> Nomor induk tidak dapat diubah
            </small>
          </div>
        </div>

        <!-- Tab Content: Location -->
        <div id="editTabLocationContent" class="edit-tab-content" style="display:none;">
          <div class="form-group">
            <label><i class="fa-solid fa-building text-indigo-400"></i> Nama Lokasi PKL / Instansi</label>
            <input type="text" id="editPklLocation" placeholder="Nama tempat PKL"
              oninput="onEditPklLocationChange(this.value)"
              style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
          </div>

          <!-- Input koordinat manual via Google Maps link -->
          <div class="form-group">
            <label><i class="fa-brands fa-google text-sky-400"></i> Tempel Link Google Maps <span style="color:#94a3b8; font-weight:400;">(opsional, untuk presisi)</span></label>
            <div style="display:flex; gap:8px;">
              <input type="text" id="editGoogleMapsLink" placeholder="https://maps.google.com/?q=-7.9825,112.6867 atau klik kanan Google Maps → Salin Koordinat" style="flex:1; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(14,165,233,0.5); border-radius:8px; color:#fff; font-size:0.8rem;">
              <button type="button" onclick="parseGoogleMapsLinkEdit()" style="padding:10px 14px; background:linear-gradient(135deg,#0284c7,#0369a1); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:0.78rem; white-space:nowrap; font-weight:600;"><i class="fa-solid fa-map-location-dot"></i> Ambil Koordinat</button>
            </div>
            <small style="color:#7dd3fc; font-size:0.72rem; margin-top:4px; display:block;"><i class="fa-solid fa-lightbulb"></i> Cara: Buka Google Maps → cari lokasi PKL → klik kanan → "Salin koordinat" → tempel di sini</small>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label><i class="fa-solid fa-map-pin text-emerald-400"></i> Latitude</label>
              <input type="text" id="editLatitude" placeholder="-7.9825" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
            </div>
            <div class="form-group">
              <label><i class="fa-solid fa-map-pin text-sky-400"></i> Longitude</label>
              <input type="text" id="editLongitude" placeholder="112.6867" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
            </div>
          </div>

          <!-- Tombol geocode ulang dari nama -->
          <div style="display:flex; gap:8px; margin-top:4px;">
            <button type="button" onclick="reGeocodeEditLocation()" style="flex:1; padding:9px 12px; background:linear-gradient(135deg,#059669,#047857); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:0.78rem; font-weight:600;"><i class="fa-solid fa-arrows-rotate"></i> Geocode Ulang dari Nama PKL</button>
            <button type="button" onclick="openGoogleMapsPreview()" style="flex:1; padding:9px 12px; background:linear-gradient(135deg,#4f46e5,#3730a3); border:none; border-radius:8px; color:#fff; cursor:pointer; font-size:0.78rem; font-weight:600;"><i class="fa-brands fa-google"></i> Cek di Google Maps</button>
          </div>

          <div id="editGeocodeFeedback" style="display:none; margin-top:10px; padding:10px 12px; border-radius:8px; font-size:0.78rem; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#34d399;"></div>

          <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:8px; padding:10px; background:rgba(79, 70, 229, 0.1); border-left:3px solid #6366f1; border-radius:6px;">
            <i class="fa-solid fa-info-circle"></i> Koordinat presisi dari Google Maps lebih akurat daripada geocoding otomatis. Gunakan tombol "Geocode Ulang" jika nama PKL sudah lengkap dan benar.
          </small>
        </div>

        <!-- Tab Content: Supervisor (only for students) -->
        <div id="editTabSupervisorContent" class="edit-tab-content" style="display:none;">
          <div class="form-group">
            <label><i class="fa-solid fa-user-tie text-indigo-400"></i> Guru Pembimbing</label>
            <select id="editSupervisor" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff; font-size:0.88rem;">
              <option value="">-- Pilih Guru Pembimbing --</option>
              <!-- Will be populated by JS -->
            </select>
            <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:4px;">
              <i class="fa-solid fa-info-circle"></i> Pilih guru pembimbing dari daftar yang terdaftar
            </small>
          </div>

          <div id="currentSupervisorInfo" style="margin-top:12px; padding:12px; background:rgba(79, 70, 229, 0.1); border-left:3px solid #6366f1; border-radius:6px;">
            <small style="color:#cbd5e1; font-size:0.8rem;">
              <i class="fa-solid fa-user-tie text-amber-400"></i> <strong>Pembimbing Saat Ini:</strong> <span id="currentSupervisorName">-</span>
            </small>
          </div>
        </div>

        <!-- Tab Content: Security -->
        <div id="editTabSecurityContent" class="edit-tab-content" style="display:none;">
          <div class="form-group">
            <label><i class="fa-solid fa-key text-purple-400"></i> Password Baru</label>
            <div class="password-input-wrapper">
              <input type="password" id="editPassword" placeholder="Masukkan password baru" style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff;">
              <button type="button" class="toggle-pwd-btn" onclick="toggleEditPasswordVisibility()" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; cursor:pointer;">
                <i class="fa-solid fa-eye" id="editPwdEyeIcon"></i>
              </button>
            </div>
            <small style="color:#94a3b8; font-size:0.75rem; display:block; margin-top:4px;">
              <i class="fa-solid fa-info-circle"></i> Kosongkan jika tidak ingin mengubah password
            </small>
          </div>

          <div style="margin-top:12px; padding:12px; background:rgba(245, 158, 11, 0.1); border-left:3px solid #f59e0b; border-radius:6px;">
            <small style="color:#fbbf24; font-size:0.8rem;">
              <i class="fa-solid fa-triangle-exclamation"></i> <strong>Perhatian:</strong> Pastikan user mencatat password baru jika diubah.
            </small>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="modal-footer" style="margin-top:24px; padding-top:16px; border-top:1px solid rgba(255,255,255,0.1); display:flex; gap:8px; flex-wrap:wrap;">
          <button type="button" class="btn-secondary" onclick="closeEditUserModal()" style="flex:1; min-width:120px;">
            <i class="fa-solid fa-xmark"></i> Batal
          </button>
          <button type="button" class="btn-primary" onclick="saveAllUserChanges()" style="flex:2; min-width:180px;">
            <i class="fa-solid fa-floppy-disk"></i> Simpan Semua Perubahan
          </button>
          <button type="button" class="btn-danger-outline" onclick="confirmDeleteUserFromModal()" id="btnDeleteFromModal" style="flex:1; min-width:120px;">
            <i class="fa-solid fa-trash"></i> Hapus User
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container"></div>

