            <select id="supervisorModalGuruSelect" required style="width:100%; padding:10px 12px; background:rgba(15,23,42,0.8); border:1px solid rgba(99,102,241,0.5); border-radius:8px; color:#fff; font-size:0.88rem; outline:none;">
              <option value="">-- Pilih Guru Pembimbing --</option>
              <!-- Will be populated by JS -->
            </select>
            <small style="display:block; margin-top:6px; color:#94a3b8; font-size:0.75rem;">
              <i class="fa-solid fa-info-circle"></i> Daftar guru otomatis dari database yang terdaftar
            </small>
          </div>

          <div class="modal-footer" style="margin-top:20px; display:flex; gap:8px;">
            <button type="button" class="btn-secondary" onclick="closeSupervisorModal()" style="flex:1;">
              <i class="fa-solid fa-xmark"></i> Batal
            </button>
            <button type="submit" class="btn-primary" style="flex:2;">
              <i class="fa-solid fa-check"></i> Simpan Perubahan
            </button>
          </div>
        </form>
      </div>
