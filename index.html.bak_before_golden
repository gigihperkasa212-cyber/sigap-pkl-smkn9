  <!-- ================= MODAL: AJUKAN KOORDINAT PKL ================= -->
  <div id="ajukanKoordModal" class="modal hidden">
    <div class="modal-overlay" onclick="closeAjukanKoordModal()"></div>
    <div class="modal-content" style="max-width:420px;">
      <div class="modal-header">
        <h3><i class="fa-solid fa-map-pin" style="color:#f59e0b;"></i> Ajukan Titik Koordinat PKL</h3>
        <button class="close-btn" onclick="closeAjukanKoordModal()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body" style="padding:16px;">

        <!-- Info langkah -->
        <div style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:0.78rem;color:#fde68a;line-height:1.6;">
          <i class="fa-solid fa-circle-info"></i>
          <strong>Petunjuk:</strong> Pastikan Anda <strong>sedang berada di lokasi PKL</strong> saat mengajukan koordinat. GPS HP akan digunakan sebagai titik koordinat yang Anda ajukan.
        </div>

        <!-- Nama PKL (read-only) -->
        <div style="margin-bottom:12px;">
          <label style="font-size:0.75rem;color:#94a3b8;display:block;margin-bottom:4px;">Nama Tempat PKL</label>
          <div id="ajukanKoordPklName" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:7px;padding:9px 12px;font-size:0.84rem;color:#e2e8f0;font-weight:600;">
            --
          </div>
        </div>

        <!-- Status GPS & koordinat yang terdeteksi -->
        <div style="margin-bottom:14px;">
          <label style="font-size:0.75rem;color:#94a3b8;display:block;margin-bottom:6px;">
            <i class="fa-solid fa-satellite-dish"></i> Koordinat GPS Anda Saat Ini
          </label>
          <div id="ajukanKoordGpsBox" style="background:rgba(15,23,42,0.7);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:12px;text-align:center;">
            <div id="ajukanKoordGpsStatus" style="color:#f59e0b;font-size:0.8rem;"><i class="fa-solid fa-spinner fa-spin"></i> Mendeteksi GPS...</div>
            <div id="ajukanKoordGpsValue" style="color:#34d399;font-size:0.88rem;font-weight:700;margin-top:6px;display:none;"></div>
            <div id="ajukanKoordGpsAccuracy" style="color:#94a3b8;font-size:0.72rem;margin-top:3px;display:none;"></div>
          </div>
          <!-- Mini map preview -->
          <div id="ajukanKoordMapBox" style="margin-top:8px;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,0.12);display:none;">
            <div id="ajukanKoordMap" style="height:150px;width:100%;"></div>
          </div>
        </div>

        <!-- Catatan opsional -->
        <div style="margin-bottom:14px;">
          <label style="font-size:0.75rem;color:#94a3b8;display:block;margin-bottom:4px;">Catatan (opsional)</label>
          <textarea id="ajukanKoordCatatan" rows="2" placeholder="Mis: Lantai 2 gedung utama, dekat lobi..."
            style="width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:7px;padding:9px 12px;font-size:0.8rem;color:#e2e8f0;resize:none;box-sizing:border-box;"></textarea>
        </div>

        <!-- Tombol aksi -->
        <div style="display:flex;gap:8px;">
          <button type="button" id="btnDeteksiUlangGps" onclick="deteksiUlangGpsAjukan()"
            style="flex:0 0 auto;background:rgba(99,102,241,0.2);color:#a5b4fc;border:1px solid rgba(99,102,241,0.4);padding:10px 14px;border-radius:8px;font-size:0.78rem;font-weight:700;cursor:pointer;">
            <i class="fa-solid fa-rotate"></i> Deteksi Ulang
          </button>
          <button type="button" id="btnKirimKoord" onclick="submitKoordPKL()" disabled
            style="flex:1;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:10px 16px;border-radius:8px;font-size:0.82rem;font-weight:700;cursor:pointer;opacity:0.5;transition:opacity 0.2s;">
            <i class="fa-solid fa-paper-plane"></i> Kirim Pengajuan
          </button>
        </div>

        <p id="ajukanKoordModalStatus" style="font-size:0.72rem;color:#94a3b8;text-align:center;margin:10px 0 0 0;display:none;"></p>
      </div>
    </div>
  </div>

  <!-- Custom App Logic -->
  <script src="js/app.js?v=2.1.50"></script>
