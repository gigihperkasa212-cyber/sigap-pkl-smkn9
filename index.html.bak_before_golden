  <script>
    // Generate bintang acak
    (function(){
      var w=document.getElementById('spStarsWrap');
      if(!w)return;
      w.style.cssText='position:absolute;inset:0;overflow:hidden;pointer-events:none;';
      for(var i=0;i<70;i++){
        var s=document.createElement('span');
        var sz=(Math.random()*2.5+.5);
        s.className='sp-star';
        s.style.cssText='width:'+sz+'px;height:'+sz+'px;'
          +'left:'+Math.random()*100+'%;top:'+Math.random()*100+'%;'
          +'opacity:'+(Math.random()*.7+.1)+';'
          +'animation-duration:'+(Math.random()*2+1)+'s;'
          +'animation-delay:'+(Math.random()*3)+'s;';
        w.appendChild(s);
      }
    })();

    // Tutup splash setelah 9 detik
    window.addEventListener('DOMContentLoaded',function(){
      setTimeout(function(){
        var el=document.getElementById('splashScreen');
        if(el){
          el.classList.add('hide');
          setTimeout(function(){el.style.display='none'; el.style.pointerEvents='none';},850);
        }
      },9000);
    });
  </script>
