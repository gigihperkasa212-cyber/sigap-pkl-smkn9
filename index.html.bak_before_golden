  <!-- ================= MODAL 5: EDIT DATA USER (COMPREHENSIVE) ================= -->
  <div id="editUserModal" class="modal hidden">
    <div class="modal-overlay" onclick="closeEditUserModal()"></div>
    <div class="modal-content" style="max-width:680px; max-height:90vh; overflow-y:auto;">
      <div class="modal-header">
        <h3><i class="fa-solid fa-pen-to-square text-indigo-400"></i> Edit Data User</h3>
        <button class="close-btn" onclick="closeEditUserModal()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body" style="padding:20px;">
        <!-- Info User Card -->
