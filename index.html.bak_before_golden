  <!-- ===== SPLASH SCREEN STYLES (inline, tidak ganggu styles.css) ===== -->
  <style>
  #splashScreen{
    position:fixed;inset:0;z-index:999999;
    background:linear-gradient(135deg,#080c1a 0%,#0d1230 40%,#1a1060 100%);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    overflow:hidden;
    transition:opacity 0.8s ease,visibility 0.8s ease;
    pointer-events:none;
  }
  #splashScreen.hide{opacity:0;visibility:hidden;pointer-events:none;}

  /* ── Partikel bintang ── */
  .sp-star{position:absolute;border-radius:50%;background:#fff;animation:spTwinkle 2s infinite alternate;}
  @keyframes spTwinkle{from{opacity:.1}to{opacity:.9}}

  /* ── Cincin orbital ── */
  .sp-orbit{
    position:absolute;border-radius:50%;border:1.5px solid transparent;
    animation:spOrbit linear infinite;
  }
  .sp-orbit::before{
    content:'';position:absolute;width:8px;height:8px;border-radius:50%;
    top:-4px;left:calc(50% - 4px);
    box-shadow:0 0 8px 3px currentColor;
  }
  .sp-orbit1{width:200px;height:200px;border-color:rgba(99,102,241,.4);color:#6366f1;animation-duration:4s;}
  .sp-orbit2{width:260px;height:260px;border-color:rgba(6,182,212,.3);color:#06b6d4;animation-duration:7s;animation-direction:reverse;}
  .sp-orbit3{width:320px;height:320px;border-color:rgba(245,158,11,.25);color:#f59e0b;animation-duration:11s;}
  @keyframes spOrbit{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

  /* ── Scene 3D logo ── */
  .sp-scene{perspective:900px;margin-bottom:32px;position:relative;}
  .sp-cube-wrap{
    width:130px;height:130px;position:relative;
    transform-style:preserve-3d;
    animation:spSpin3d 3.5s cubic-bezier(.4,0,.2,1) forwards,
              spFloat 3s ease-in-out 3.5s infinite alternate;
  }
  .sp-face{
    position:absolute;width:130px;height:130px;
    border-radius:24px;overflow:hidden;
    backface-visibility:hidden;
    border:2px solid rgba(99,102,241,.6);
    box-shadow:0 0 30px rgba(99,102,241,.4) inset,0 0 20px rgba(99,102,241,.3);
  }
  .sp-face img{width:100%;height:100%;object-fit:contain;padding:8px;}
  .sp-face-front {transform:translateZ(65px);background:#ffffff;}
  .sp-face-back  {transform:rotateY(180deg) translateZ(65px);background:#f8faff;}
  .sp-face-right {transform:rotateY(90deg) translateZ(65px);background:#f0f4ff;}
  .sp-face-left  {transform:rotateY(-90deg) translateZ(65px);background:#f0f4ff;}
  .sp-face-top   {transform:rotateX(90deg) translateZ(65px);background:#f8faff;}
  .sp-face-bottom{transform:rotateX(-90deg) translateZ(65px);background:#f8faff;}

  @keyframes spSpin3d{
    0%  {transform:rotateX(-30deg) rotateY(-180deg) scale(.3);opacity:0;}
    20% {opacity:1;}
    60% {transform:rotateX(10deg) rotateY(30deg) scale(1.08);}
    80% {transform:rotateX(-5deg) rotateY(-10deg) scale(.98);}
    100%{transform:rotateX(0deg) rotateY(0deg) scale(1);}
  }
  @keyframes spFloat{
    from{transform:rotateX(4deg) rotateY(-6deg) translateY(0px);}
    to  {transform:rotateX(-4deg) rotateY(6deg) translateY(-14px);}
  }

  /* ── Glow ring ── */
  .sp-glow{
    position:absolute;inset:-20px;border-radius:50%;
    background:conic-gradient(#6366f1,#06b6d4,#f59e0b,#6366f1);
    filter:blur(16px);opacity:.5;
    animation:spGlowRot 4s linear infinite;
  }
  @keyframes spGlowRot{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

  /* ── Pulse rings ── */
  .sp-pulse{
    position:absolute;inset:-12px;border-radius:50%;
    border:2px solid rgba(99,102,241,.5);
    animation:spPulseOut 2s ease-out infinite;
  }
  .sp-pulse:nth-child(2){animation-delay:.7s;}
  .sp-pulse:nth-child(3){animation-delay:1.4s;}
  @keyframes spPulseOut{0%{transform:scale(1);opacity:.7}100%{transform:scale(2.4);opacity:0}}

  /* ── Teks ── */
  .sp-title{
    font-family:'Plus Jakarta Sans',sans-serif;font-size:2.8rem;font-weight:800;
    letter-spacing:.15em;
    background:linear-gradient(90deg,#818cf8,#06b6d4,#fbbf24,#818cf8);
    background-size:200% auto;
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    animation:spFadeUp .6s ease .5s both,spShine 3s linear 1s infinite;
    margin-bottom:6px;
  }
  @keyframes spShine{to{background-position:200% center}}
  .sp-sub{
    font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:500;
    color:rgba(148,163,184,.85);letter-spacing:.06em;text-align:center;
    animation:spFadeUp .6s ease .8s both;
    margin-bottom:36px;
  }
  @keyframes spFadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

  /* ── Loading bar ── */
  .sp-bar-wrap{
    width:200px;height:4px;background:rgba(255,255,255,.08);
    border-radius:99px;overflow:hidden;
    animation:spFadeUp .6s ease 1s both;
    margin-bottom:10px;
  }
  .sp-bar{
    height:100%;width:0%;border-radius:99px;
    background:linear-gradient(90deg,#6366f1,#06b6d4,#f59e0b);
    animation:spLoad 8.4s cubic-bezier(.4,0,.2,1) .4s forwards;
  }
  @keyframes spLoad{
    0%{width:0%}10%{width:6%}25%{width:22%}
    50%{width:50%}75%{width:75%}90%{width:90%}100%{width:100%}
  }
  .sp-loading-txt{
    font-family:'Plus Jakarta Sans',sans-serif;font-size:.65rem;
    color:rgba(148,163,184,.55);letter-spacing:.14em;text-transform:uppercase;
    animation:spFadeUp .6s ease 1.1s both;
    margin-bottom:8px;
  }

  /* ── Badge sekolah ── */
  .sp-school{
    position:absolute;bottom:28px;left:0;right:0;text-align:center;
    font-family:'Plus Jakarta Sans',sans-serif;font-size:.65rem;
    color:rgba(148,163,184,.4);letter-spacing:.04em;
    animation:spFadeUp .6s ease 1.4s both;
  }
